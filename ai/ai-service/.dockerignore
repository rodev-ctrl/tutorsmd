# Виртуальные окружения. Без этого COPY . . тащит их в образ целиком:
# на машине разработчика это .venv на 235 МБ и venv на 14 МБ, собранные
# под другую ОС и другую версию Python — в образе они бесполезны и вредны,
# потому что перекрывают то, что установил pip внутри контейнера.
.venv
venv
env
ENV

# Байткод: генерируется при импорте, в образе не нужен.
__pycache__
*.pyc
*.pyo
*.pyd

# Секреты. Переменные приходят через env_file в docker-compose,
# внутрь образа они попадать не должны.
.env
.env.*

.git
.gitignore

# Тесты и eval-харнесс в рантайме не участвуют.
tests

.vscode
.idea

*.log
.pytest_cache
.mypy_cache
.ruff_cache

Dockerfile
.dockerignore

.DS_Store
Thumbs.db

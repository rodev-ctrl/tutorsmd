{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Бандлит vite, tsc здесь нужен ТОЛЬКО для проверки типов
    // (скрипт build = "tsc && vite build").
    // Без noEmit шаг `tsc` раскладывал скомпилированные .js рядом с каждым
    // .tsx прямо в src/ — 99 файлов. Они попадали под линтер, дублировали
    // исходники в поиске по проекту и выглядели как живой код. В git не
    // уходили (frontend/.gitignore: *.js), поэтому в CI проблема не
    // проявлялась и жила только у разработчика на диске.
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],

    "baseUrl": ".",
    "ignoreDeprecations": "5.0",   // baseUrl теперь принимается на 5-й версии

    "paths": {
      "@app/*":      ["src/app/*"],
      "@pages/*":    ["src/pages/*"],
      "@widgets/*":  ["src/widgets/*"],
      "@features/*": ["src/features/*"],
      "@entities/*": ["src/entities/*"],
      "@shared/*":   ["src/shared/*"]
    }
  },
  "include": ["src", "index.tsx", "reportWebVitals.ts"],
  "exclude": ["node_modules", "dist"]
}
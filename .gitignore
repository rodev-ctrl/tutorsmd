# Скомпилированный вывод TypeScript рядом с исходниками.
# Правило намеренно широкое: проект целиком на TS, и любой .js в src —
# почти наверняка артефакт сборки. Раньше такие файлы затеняли свои .tsx
# при сборке (vite резолвит .js раньше .ts), см. frontend/vite.config.ts.
**/*.js
*.js

# Исключения — настоящие JS-файлы, которые обязаны быть в репозитории.
!**/*.config.js
# Хуки Claude Code: на них ссылается отслеживаемый .claude/settings.json,
# поэтому без них свежий клон получает настроенные, но отсутствующие хуки.
!.claude/hooks/*.js


